{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "Issuer": "ISSUER_URL",
    "Audience": "AUDIENCE_URL",
    "ExpiryMinutes": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/Auth/{**catchall}" }
      },
      "trainee-route": {
        "ClusterId": "trainee-cluster",
        "AuthorizationPolicy": "AdminOrTrainee",
        "Match": { "Path": "/api/Trainee/{**catchall}" }
      },
      "mentor-route": {
        "ClusterId": "mentor-cluster",
        "AuthorizationPolicy": "AdminOrMentor",
        "Match": { "Path": "/api/Mentor/{**catchall}" }
      },
      "learning-task-route": {
        "ClusterId": "learning-task-cluster",
        "AuthorizationPolicy": "AdminOrMentor",
        "Match": { "Path": "/api/LearningTask/{**catchall}" }
      },
      "task-assignment-route": {
        "ClusterId": "task-assignment-cluster",
        "AuthorizationPolicy": "AdminOrMentor",
        "Match": { "Path": "/api/TaskAssignment/{**catchall}" }
      },
      "trainee-add-submission-route": {
        "ClusterId": "submission-cluster",
        "AuthorizationPolicy": "TraineeOnly",
        "Match": { 
          "Path": "/api/Submission", 
          "Methods": ["POST"] 
        }
      },
      "get-submission-by-id-route": {
        "ClusterId": "submission-cluster",
        "AuthorizationPolicy": "AdminOrTraineeOrMentor",
        "Match": { 
          "Path": "/api/Submission/{id}", 
          "Methods": ["GET"] 
        }
      },
      "get-all-submissions-route": {
        "ClusterId": "submission-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { 
          "Path": "/api/Submission", 
          "Methods": ["GET"] 
        }
      },
      "download-submission-file-route": {
        "ClusterId": "submission-cluster",
        "AuthorizationPolicy": "TraineeOrMentor",
        "Match": { 
          "Path": "/api/Submission/submission-files/{submissionFileId}", 
          "Methods": ["GET"] 
        }
      },
      "delete-submission-file-route": {
        "ClusterId": "submission-cluster",
        "AuthorizationPolicy": "TraineeOnly",
        "Match": { 
          "Path": "/api/Submission/submission-files/{submissionFileId}", 
          "Methods": ["DELETE"] 
        }
      },
      "add-review-route": {
        "ClusterId": "review-cluster",
        "AuthorizationPolicy": "MentorOnly",
        "Match": { 
          "Path": "/api/Review", 
          "Methods": ["POST"] 
        }
      },
      "get-review-by-id-route": {
        "ClusterId": "review-cluster",
        "AuthorizationPolicy": "AdminOrTraineeOrMentor",
        "Match": { 
          "Path": "/api/Review/{id}", 
          "Methods": ["GET"] 
        }
      },
      "get-all-review-route": {
        "ClusterId": "review-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { 
          "Path": "/api/Review", 
          "Methods": ["GET"] 
        }
      },
      "get-processing-job-route": {
        "ClusterId": "processing-job-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { 
          "Path": "/api/ProcessingJob/{id}", 
          "Methods": ["GET"] 
        }
      },
      "application-health-status-route": {
        "ClusterId": "health-cluster",
        "AuthorizationPolicy": "AdminOnly",
        "Match": { 
          "Path": "/api/Healh/{**catchall}", 
          "Methods": ["GET"] 
        }
      },
      "inter-service-communication-route": {
        "ClusterId": "inter-service-communication-cluster",
        "AuthorizationPolicy": "AdminOrTrainee",
        "Match": { 
          "Path": "/api/Trainee/dummy-trainee/{id}", 
          "Methods": ["GET"] 
        }
      }
    },
    "Clusters": {
      "auth-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "trainee-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "mentor-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "learning-task-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "task-assignment-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "submission-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "review-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "processing-job-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "health-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } },
      "inter-service-communication-cluster": { "Destinations": { "d1": { "Address": "http://docker_service_name:port_number/" } } }
    }
  }
}
